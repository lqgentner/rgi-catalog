{
  "version": 8,
  "name": "Terminus type",
  "metadata": {
    "description": "Glaciers by terminus type (term_type). RGI 7.0 assigns only the marine-terminating class."
  },
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../../rgi7.0.pmtiles"
    }
  },
  "layers": [
    {
      "id": "glaciers-terminus-type",
      "type": "fill",
      "source-layer": "glaciers",
      "paint": {
        "fill-color": [
          "match",
          [
            "match",
            [
              "get",
              "term_type"
            ],
            1,
            "Marine-terminating",
            9,
            "Not assigned",
            ""
          ],
          "Marine-terminating",
          "#0072b2",
          "Not assigned",
          "#9e9e9e",
          "#9e9e9e"
        ],
        "fill-opacity": 0.8
      },
      "source": "data"
    },
    {
      "id": "glaciers-outline",
      "type": "line",
      "source-layer": "glaciers",
      "paint": {
        "line-color": [
          "match",
          [
            "match",
            [
              "get",
              "term_type"
            ],
            1,
            "Marine-terminating",
            9,
            "Not assigned",
            ""
          ],
          "Marine-terminating",
          "#0072b2",
          "Not assigned",
          "#9e9e9e",
          "#9e9e9e"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          1.2,
          8,
          0.6,
          12,
          1.0
        ]
      },
      "source": "data"
    },
    {
      "id": "glaciers-dots",
      "type": "circle",
      "source-layer": "glaciers",
      "filter": [
        "in",
        [
          "geometry-type"
        ],
        [
          "literal",
          [
            "Point",
            "MultiPoint"
          ]
        ]
      ],
      "paint": {
        "circle-color": [
          "match",
          [
            "match",
            [
              "get",
              "term_type"
            ],
            1,
            "Marine-terminating",
            9,
            "Not assigned",
            ""
          ],
          "Marine-terminating",
          "#0072b2",
          "Not assigned",
          "#9e9e9e",
          "#9e9e9e"
        ],
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          1.5,
          6,
          2.5
        ],
        "circle-opacity": 0.85
      },
      "source": "data"
    },
    {
      "id": "glacier-labels",
      "type": "symbol",
      "layout": {
        "text-field": [
          "get",
          "display_name"
        ],
        "text-font": [
          "Open Sans Italic"
        ],
        "text-size": 12,
        "symbol-sort-key": [
          "-",
          [
            "get",
            "area_km2"
          ]
        ]
      },
      "paint": {
        "text-color": "#0d2a5c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      },
      "source-layer": "glacier-labels",
      "source": "data"
    }
  ]
}
