{
  "version": 8,
  "name": "Terminus type",
  "metadata": {
    "description": "Glaciers coloured by terminus type (term_type). RGI 7.0 assigns only the marine-terminating class. Every other glacier is not assigned."
  },
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../rgi7.0.pmtiles"
    }
  },
  "layers": [
    {
      "id": "glaciers-terminus-type",
      "type": "fill",
      "source-layer": "glaciers",
      "paint": {
        "fill-color": [
          "match",
          [
            "match",
            [
              "get",
              "term_type"
            ],
            1,
            "Marine-terminating",
            9,
            "Not assigned",
            ""
          ],
          "Marine-terminating",
          "#08519c",
          "Not assigned",
          "#bdbdbd",
          "#bdbdbd"
        ],
        "fill-opacity": 0.8
      },
      "source": "data"
    },
    {
      "id": "glaciers-outline",
      "type": "line",
      "source-layer": "glaciers",
      "minzoom": 10,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": 0.4
      },
      "source": "data"
    },
    {
      "id": "glacier-labels",
      "type": "symbol",
      "layout": {
        "text-field": [
          "get",
          "display_name"
        ],
        "text-font": [
          "Open Sans Italic"
        ],
        "text-size": 12,
        "symbol-sort-key": [
          "-",
          [
            "get",
            "area_km2"
          ]
        ]
      },
      "paint": {
        "text-color": "#08306b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      },
      "source-layer": "glacier-labels",
      "source": "data"
    }
  ]
}
