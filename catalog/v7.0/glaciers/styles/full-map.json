{
  "version": 8,
  "name": "Glaciers with names",
  "metadata": {
    "description": "Glacier outlines (blue) with glacier names. Larger glaciers are named at lower zooms."
  },
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../rgi7.0.pmtiles"
    }
  },
  "layers": [
    {
      "id": "glaciers-fill",
      "type": "fill",
      "paint": {
        "fill-color": "#9ecae1",
        "fill-opacity": 0.5
      },
      "source-layer": "glaciers",
      "source": "data"
    },
    {
      "id": "glaciers-outline",
      "type": "line",
      "minzoom": 8,
      "paint": {
        "line-color": "#2171b5",
        "line-width": 0.8
      },
      "source-layer": "glaciers",
      "source": "data"
    },
    {
      "id": "glacier-labels",
      "type": "symbol",
      "layout": {
        "text-field": [
          "get",
          "display_name"
        ],
        "text-font": [
          "Open Sans Italic"
        ],
        "text-size": 12,
        "symbol-sort-key": [
          "-",
          [
            "get",
            "area_km2"
          ]
        ]
      },
      "paint": {
        "text-color": "#08306b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      },
      "source-layer": "glacier-labels",
      "source": "data"
    }
  ]
}
