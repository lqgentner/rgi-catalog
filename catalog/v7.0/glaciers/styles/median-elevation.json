{
  "version": 8,
  "name": "Median elevation",
  "metadata": {
    "description": "Glaciers by median elevation (zmed_m), in 1,000 m classes."
  },
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../../rgi7.0.pmtiles"
    }
  },
  "layers": [
    {
      "id": "glaciers-median-elevation",
      "type": "fill",
      "source-layer": "glaciers",
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "zmed_m"
          ],
          "#a88bd9",
          1000,
          "#8c69c8",
          2000,
          "#7050b2",
          3000,
          "#573a96",
          4000,
          "#3f2875",
          5000,
          "#291852"
        ],
        "fill-opacity": 0.8
      },
      "source": "data"
    },
    {
      "id": "glaciers-outline",
      "type": "line",
      "source-layer": "glaciers",
      "paint": {
        "line-color": [
          "step",
          [
            "get",
            "zmed_m"
          ],
          "#a88bd9",
          1000,
          "#8c69c8",
          2000,
          "#7050b2",
          3000,
          "#573a96",
          4000,
          "#3f2875",
          5000,
          "#291852"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          1.2,
          8,
          0.6,
          12,
          1.0
        ]
      },
      "source": "data"
    },
    {
      "id": "glaciers-dots",
      "type": "circle",
      "source-layer": "glaciers",
      "filter": [
        "in",
        [
          "geometry-type"
        ],
        [
          "literal",
          [
            "Point",
            "MultiPoint"
          ]
        ]
      ],
      "paint": {
        "circle-color": [
          "step",
          [
            "get",
            "zmed_m"
          ],
          "#a88bd9",
          1000,
          "#8c69c8",
          2000,
          "#7050b2",
          3000,
          "#573a96",
          4000,
          "#3f2875",
          5000,
          "#291852"
        ],
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          1.5,
          6,
          2.5
        ],
        "circle-opacity": 0.85
      },
      "source": "data"
    },
    {
      "id": "glacier-labels",
      "type": "symbol",
      "layout": {
        "text-field": [
          "get",
          "display_name"
        ],
        "text-font": [
          "Open Sans Italic"
        ],
        "text-size": 12,
        "symbol-sort-key": [
          "-",
          [
            "get",
            "area_km2"
          ]
        ]
      },
      "paint": {
        "text-color": "#0d2a5c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      },
      "source-layer": "glacier-labels",
      "source": "data"
    }
  ]
}
