{
  "version": 8,
  "name": "Same as RGI 6.0",
  "metadata": {
    "description": "Glaciers coloured by whether the outline is the same as in RGI 6.0 (is_rgi6) or new in RGI 7.0, as in the map of the RGI 7.0 user guide."
  },
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../../rgi7.0.pmtiles"
    }
  },
  "layers": [
    {
      "id": "glaciers-same-as-rgi6",
      "type": "fill",
      "source-layer": "glaciers",
      "paint": {
        "fill-color": [
          "match",
          [
            "case",
            [
              "get",
              "is_rgi6"
            ],
            "Same as RGI 6.0",
            "New in RGI 7.0"
          ],
          "Same as RGI 6.0",
          "#1f77b4",
          "New in RGI 7.0",
          "#d62728",
          "#bdbdbd"
        ],
        "fill-opacity": 0.8
      },
      "source": "data"
    },
    {
      "id": "glaciers-outline",
      "type": "line",
      "source-layer": "glaciers",
      "paint": {
        "line-color": [
          "match",
          [
            "case",
            [
              "get",
              "is_rgi6"
            ],
            "Same as RGI 6.0",
            "New in RGI 7.0"
          ],
          "Same as RGI 6.0",
          "#1f77b4",
          "New in RGI 7.0",
          "#d62728",
          "#bdbdbd"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          1.2,
          8,
          0.6,
          12,
          1.0
        ]
      },
      "source": "data"
    },
    {
      "id": "glaciers-dots",
      "type": "circle",
      "source-layer": "glaciers",
      "filter": [
        "in",
        [
          "geometry-type"
        ],
        [
          "literal",
          [
            "Point",
            "MultiPoint"
          ]
        ]
      ],
      "paint": {
        "circle-color": [
          "match",
          [
            "case",
            [
              "get",
              "is_rgi6"
            ],
            "Same as RGI 6.0",
            "New in RGI 7.0"
          ],
          "Same as RGI 6.0",
          "#1f77b4",
          "New in RGI 7.0",
          "#d62728",
          "#bdbdbd"
        ],
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          1.5,
          6,
          2.5
        ],
        "circle-opacity": 0.85
      },
      "source": "data"
    },
    {
      "id": "glacier-labels",
      "type": "symbol",
      "layout": {
        "text-field": [
          "get",
          "display_name"
        ],
        "text-font": [
          "Open Sans Italic"
        ],
        "text-size": 12,
        "symbol-sort-key": [
          "-",
          [
            "get",
            "area_km2"
          ]
        ]
      },
      "paint": {
        "text-color": "#08306b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      },
      "source-layer": "glacier-labels",
      "source": "data"
    }
  ]
}
